# Non-sensitive config for the Next.js/Payload app (secrets come from Vault via
# the ExternalSecret -> mdp-website-secret). See app repo site/.env.example.
NODE_ENV=production
NEXT_PUBLIC_SERVER_URL=https://website.poc.mdplabs.dev
REVALIDATE_URL=https://website.poc.mdplabs.dev
MEDIA_DIR=/data/media
# Schema is managed by committed Payload migrations, applied by the `migrate`
# init-container in the base Deployment before the app starts. Keep push OFF so
# migrations are the single source of truth (push is dev-only and unreliable in
# production — it previously left the payload_jobs tables uncreated).
PAYLOAD_DB_PUSH=false
